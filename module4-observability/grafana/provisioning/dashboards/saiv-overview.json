{
  "uid": "saiv-overview",
  "title": "SAIV System Health",
  "description": "Backend and face service health. Attendance data itself lives in the Streamlit dashboard on port 8501; this is the infrastructure view.",
  "tags": [
    "saiv"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Request rate",
      "description": "Backend requests per second, averaged over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(saiv_http_requests_total[5m]))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "The briefing's target is under 2 seconds at 100 concurrent users, which is where the red threshold sits.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(saiv_http_request_duration_seconds_bucket[5m])) by (le))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "Share of responses that are 5xx. Two guards: `or vector(0)` so a stack with no errors reads 0 percent instead of No data, and clamp_min so no traffic at all reads 0 rather than NaN.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(saiv_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(saiv_http_requests_total[5m])), 0.0001)",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "In flight",
      "description": "Requests being handled right now. Parked at the admission cap means the queue has moved to the event loop and latency is about to climb.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "saiv_http_requests_in_progress",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Route template, not URL. Every check-in would otherwise be its own series.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(saiv_http_requests_total[5m])) by (path)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean"
          ],
          "width": 260
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "Computed from the histogram, so it is a real quantile over the window rather than an average of per-scrape averages.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(saiv_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean"
          ],
          "width": 260
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Check-in outcomes",
      "description": "Check-ins arriving per 5 minutes, by decision. Counted rather than rated: a lecture produces a burst at the start and nothing after, and per-second rate renders that as a flat 0.008.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(saiv_checkins_total[5m])) by (outcome)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Risk score quantiles",
      "description": "Risk assigned at check-in. p99 climbing while p50 holds is a few students tripping signals; both climbing is usually the venue coordinates being wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum(rate(saiv_checkin_risk_score_bucket[10m])) by (le))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum(rate(saiv_checkin_risk_score_bucket[10m])) by (le))",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "p90"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(saiv_checkin_risk_score_bucket[10m])) by (le))",
          "range": true,
          "instant": false,
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Face service p95",
      "description": "Enrol, verify, liveness and risk. Empty until the face service has handled something; nothing polls it on a timer.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(saiv_face_request_duration_seconds_bucket[5m])) by (le, path))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP status classes",
      "description": "401 and 403 climbing without 5xx is someone probing, not a broken deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(saiv_http_requests_total[5m])) by (status)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "heatmap",
      "title": "Face match scores",
      "description": "Two humps are expected, same person and different person, and the match threshold belongs in the gap between them. A heatmap rather than lines because cumulative buckets drawn as lines are not a distribution.",
      "datasource": {
        "type": "prometheus",
        "uid": "saiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saiv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(saiv_face_match_score_bucket[10m])) by (le)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 64,
          "fill": "dark-blue",
          "reverse": false
        },
        "yAxis": {
          "unit": "short",
          "decimals": 1
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    }
  ]
}